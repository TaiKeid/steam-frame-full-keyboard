{
  "version": 5,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host development build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug",
                         "FRAMEKEYBOARD_EXECUTORCH_DIR": "$env{FRAMEKEYBOARD_EXECUTORCH_HOST}",
                         "FRAMEKEYBOARD_WHISPER_DIR": "$env{FRAMEKEYBOARD_WHISPER_HOST}",
                         "FRAMEKEYBOARD_MOZC_SERVER": "$env{FRAMEKEYBOARD_MOZC_HOST}"}
    },
    {
      "name": "sanitized",
      "displayName": "Host ASan and UBSan build",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/sanitized",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "simulator",
      "displayName": "Desktop simulator only, without SteamVR or Vulkan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/simulator",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo",
                         "FRAMEKEYBOARD_VR": "OFF",
                         "BUILD_TESTING": "OFF",
                         "FRAMEKEYBOARD_EXECUTORCH_DIR": "$env{FRAMEKEYBOARD_EXECUTORCH_HOST}",
                         "FRAMEKEYBOARD_MOZC_SERVER": "$env{FRAMEKEYBOARD_MOZC_HOST}"}
    },
    {
      "name": "frame-arm64",
      "displayName": "Steam Frame ARM64 cross-build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/frame-arm64",
      "toolchainFile": "${sourceDir}/cmake/steam-frame-aarch64.cmake",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo",
                         "FRAMEKEYBOARD_EXECUTORCH_DIR": "$env{FRAMEKEYBOARD_EXECUTORCH_FRAME}",
                         "FRAMEKEYBOARD_WHISPER_DIR": "$env{FRAMEKEYBOARD_WHISPER_FRAME}",
                         "FRAMEKEYBOARD_MOZC_SERVER": "$env{FRAMEKEYBOARD_MOZC_FRAME}"}
    }
  ],
  "buildPresets": [
    {"name": "host", "configurePreset": "host"},
    {"name": "sanitized", "configurePreset": "sanitized"},
    {"name": "simulator", "configurePreset": "simulator", "targets": ["framekeyboard-simulator"]},
    {"name": "frame-arm64", "configurePreset": "frame-arm64"}
  ],
  "testPresets": [
    {
      "name": "sanitized",
      "displayName": "Host sanitizers, unsuppressed",
      "configurePreset": "sanitized",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1",
        "LSAN_OPTIONS": null
      },
      "output": {"outputOnFailure": true},
      "execution": {"noTestsAction": "error"}
    },
    {
      "name": "sanitized-fontconfig-filtered",
      "displayName": "Host sanitizers, Fontconfig and Anthy allocations filtered",
      "inherits": "sanitized",
      "environment": {
        "LSAN_OPTIONS": "suppressions=${sourceDir}/build/sanitized/lsan-third-party.supp:print_suppressions=1"
      }
    }
  ]
}
