#!/bin/sh
# Starts the desktop simulator from its AppImage (docs/simulator.md). Its own
# libraries come first; the bundled Anthy and emoji dictionaries and Chinese
# tables are used unless others were given. Child programs inherit this path;
# C/C++ runtimes stay on the host so its helpers and graphics plugins use theirs.
here=$(dirname "$(readlink -f "$0")")
LD_LIBRARY_PATH="$here/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
if [ -z "${FRAMEKEYBOARD_ANTHY_DICTIONARY:-}" ] && [ -f "$here/usr/share/anthy/anthy.dic" ]; then
    FRAMEKEYBOARD_ANTHY_DICTIONARY="$here/usr/share/anthy/anthy.dic"
    export FRAMEKEYBOARD_ANTHY_DICTIONARY
fi
if [ -z "${FRAMEKEYBOARD_EMOJI_DICTIONARY:-}" ] && [ -f "$here/usr/share/ibus/dicts/emoji-ja.dict" ]; then
    FRAMEKEYBOARD_EMOJI_DICTIONARY="$here/usr/share/ibus/dicts/emoji-ja.dict"
    export FRAMEKEYBOARD_EMOJI_DICTIONARY
fi
if [ -z "${FRAMEKEYBOARD_TABLE_DIRECTORY:-}" ] && [ -f "$here/usr/share/ibus-table/tables/cangjie5.db" ]; then
    FRAMEKEYBOARD_TABLE_DIRECTORY="$here/usr/share/ibus-table/tables"
    export FRAMEKEYBOARD_TABLE_DIRECTORY
fi
exec "$here/usr/bin/framekeyboard-simulator" "$@"
